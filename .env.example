# =============================================================================
# Falcone AI — Environment Variables
# =============================================================================

# --- LLM Backend ---
LLM_BACKEND=openai

# --- OpenAI-compatible (DeepSeek, Groq, xAI, OpenRouter, etc.) ---
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- vLLM ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Ollama ---
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_NUM_THREADS=6
# OLLAMA_NUM_CTX=32768

# --- GGUF ---
# GGUF_MODEL_PATH=./models/model.gguf
# GGUF_N_CTX=32768
# GGUF_N_THREADS=6
# GGUF_MAX_TOKENS=1024

# --- Transformers ---
# TRANSFORMERS_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
# TRANSFORMERS_MAX_TOKENS=1024

# --- Vector Database ---
QDRANT_PATH=./qdrant_db